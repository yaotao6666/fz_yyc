# 应用程序配置
APP_NAME=fz_yyc_api
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fz_yyc
DB_PASSWORD=fz_yyc123
DB_NAME=fz_yyc_api
DB_CHARSET=utf8mb4
DB_MAX_IDLE=10
DB_MAX_OPEN=100
DB_LIFE_TIME=3600

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE=720

# 微信支付配置
WECHAT_PAY_SP_MCH_ID=your-sp-mch-id
# 服务商下单 sp_appid：须与服务商商户号绑定的小程序 appid
WECHAT_PAY_SP_APP_ID=your-sp-miniapp-appid
WECHAT_PAY_SP_CALLBACK_URL=http://127.0.0.1:8080/api/v1/callback/wechatpay/pay
WECHAT_PAY_SP_REFUND_CALLBACK_URL=http://127.0.0.1:8080/api/v1/callback/wechatpay/refund

# 微信支付配置 - APIV3密钥
WECHAT_PAY_SP_API_V3_KEY=your-api-key-v3
# 公钥ID
WECHAT_PAY_SP_PUBLIC_KEY_ID=your-public-key-id
# 公钥
WECHAT_PAY_SP_PUBLIC_KEY=pub_key.pem

# 用户端(C端)小程序配置（登录、下单收单 sub_appid、二维码生成等）
WECHAT_APP_ID=your-miniapp-appid
WECHAT_APP_SECRET=your-miniapp-appsecret

# 服务人员端小程序配置（服务人员端登录，与用户端独立；可缺省则回退用户端配置）
WECHAT_STAFF_APP_ID=your-staff-miniapp-appid
WECHAT_STAFF_APP_SECRET=your-staff-miniapp-appsecret

# 七牛云配置
QINIU_ACCESS_KEY=your-access-key
QINIU_SECRET_KEY=your-secret-key
QINIU_BUCKET=your-bucket
QINIU_DOMAIN=https://your-domain.com
