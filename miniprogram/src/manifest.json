{
  "name": "寻梦私域管家",
  "appid": "wx684960f1efea2738",
  "description": "专为中小商家打造的统一私域经营平台",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "wx684960f1efea2738",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "获取您的位置信息用于配送"
      }
    },
    "requiredPrivateInfos": ["chooseAddress"]
  },
  "h5": {
    "devServer": {
      "port": 3000,
      "disableHostCheck": true,
      "proxy": {
        "/api": {
          "target": "http://localhost:8080",
          "changeOrigin": true,
          "secure": false
        }
      }
    },
    "router": {
      "mode": "hash"
    },
    "title": "寻梦私域管家"
  }
}
