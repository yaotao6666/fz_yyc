# 应用程序配置
APP_NAME=fz_yyc_api
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=production
APP_DEBUG=false

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=fz_yyc
DB_PASSWORD=change-me
DB_NAME=fz_yyc_api
DB_CHARSET=utf8mb4
DB_MAX_IDLE=10
DB_MAX_OPEN=100
DB_LIFE_TIME=3600

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# JWT 配置
JWT_SECRET=change-me
JWT_EXPIRE=720

# 微信支付配置（生产必须为 HTTPS 可达地址）
WECHAT_PAY_SP_MCH_ID=change-me
# 服务商下单 sp_appid：须与服务商商户号绑定的小程序 appid
WECHAT_PAY_SP_APP_ID=change-me
WECHAT_PAY_SP_API_V3_KEY=change-me
WECHAT_PAY_SP_CERT_SERIAL_NO=change-me
WECHAT_PAY_SP_PRIVATE_KEY=/app/certs/apiclient_key.pem
WECHAT_PAY_SP_PUBLIC_KEY=/app/certs/pub_key.pem
WECHAT_PAY_SP_CALLBACK_URL=https://fzyyc.jxxme.cn/api/v1/notify/payment

# 微信小程序配置（登录、支付、二维码等统一使用该 AppID/AppSecret）
WECHAT_APP_ID=change-me
WECHAT_APP_SECRET=change-me

# 七牛云配置
QINIU_ACCESS_KEY=change-me
QINIU_SECRET_KEY=change-me
QINIU_BUCKET=change-me
QINIU_DOMAIN=https://your-cdn-domain.com
QINIU_UPLOAD_URL=https://up-z0.qiniup.com
